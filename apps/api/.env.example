# ─────────────────────────────────────────────────────────────
# TrustEscrow NG — Environment Variables
# Copy this file to .env.development and fill in your values.
# NEVER commit .env.development or .env.production to git.
# ─────────────────────────────────────────────────────────────

# ─── SERVER ──────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
LOG_LEVEL=debug

# ─── SECURITY ────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
ADMIN_JWT_SECRET=change-me-min-32-chars-openssl-rand-hex-32
# Generate with: openssl rand -hex 32  (must be exactly 64 hex chars for AES-256)
ENCRYPTION_KEY=change-me-must-be-exactly-64-hex-characters-use-openssl-rand-hex32
# Generate with: openssl rand -hex 16
NIN_SALT=change-me-random-nin-salt

# ─── DATABASE ────────────────────────────────────────────────
# Local (docker-compose): postgresql://trustescrow:devpass@localhost:5432/trustescrow_dev
# Railway: automatically injected
DATABASE_URL=postgresql://trustescrow:devpass@localhost:54320/trustescrow_dev

# ─── REDIS ───────────────────────────────────────────────────
# Local (docker-compose): redis://localhost:6379
# Upstash prod: rediss://default:xxxxxxxx@us1-xxx.upstash.io:6379
REDIS_URL=redis://localhost:6379

# ─── AFRICA'S TALKING ────────────────────────────────────────
# Dev:  username='sandbox', key from sandbox app in AT dashboard
# Prod: username=your-account-username, key from live app
# Dashboard: https://account.africastalking.com
AT_USERNAME=sandbox
AT_API_KEY=atsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AT_SHORTCODE=15629
AT_SENDER_ID=TRUSTESCROW

# ─── PAYSTACK ────────────────────────────────────────────────
# Test keys (dev):  sk_test_xxx / pk_test_xxx
# Live keys (prod): sk_live_xxx / pk_live_xxx
# Dashboard: https://dashboard.paystack.com/#/settings/developer
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# PAYSTACK_WEBHOOK_SECRET is the same as PAYSTACK_SECRET_KEY
PAYSTACK_WEBHOOK_SECRET=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_DVA_PROVIDER=wema-bank

# ─── PREMBLY IDENTITYPASS ────────────────────────────────────
# Sandbox (dev):  base URL = https://sandbox.prembly.com
# Live (prod):    base URL = https://api.prembly.com
# Dashboard: https://dashboard.prembly.com
PREMBLY_API_KEY=sandbox_xxxxxxxxxxxxxxxxxxxxxxxx
PREMBLY_APP_ID=sandbox_xxxxxxxx
PREMBLY_BASE_URL=https://sandbox.prembly.com

# ─── AI PROVIDER ─────────────────────────────────────────────
# Choose: 'gemini' or 'anthropic'
AI_PROVIDER=gemini

# ─── GOOGLE GEMINI ───────────────────────────────────────────
# Get your API key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash-exp
GEMINI_MAX_TOKENS=1024

# ─── ANTHROPIC CLAUDE (OPTIONAL) ─────────────────────────────
# Only needed if AI_PROVIDER=anthropic
# Dashboard: https://console.anthropic.com
# ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_MAX_TOKENS=1024

# ─── TWILIO FALLBACK SMS ─────────────────────────────────────
# Dashboard: https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_FROM_NUMBER=+15005550006

# ─── MONITORING ──────────────────────────────────────────────
SENTRY_DSN=https://xxxxxxxx@oXXXXXX.ingest.sentry.io/XXXXXXX
AXIOM_TOKEN=xapt-xxxxxxxxxxxxxxxxxxxxxxxx
AXIOM_DATASET=trustescrow-logs

# ─── FEATURE FLAGS ───────────────────────────────────────────
# Set USE_MOCK_NIN=true in dev to bypass real Prembly calls
USE_MOCK_NIN=true
USE_MOCK_PAYSTACK=false
# Deals above this amount (in kobo) trigger liveness check
# 500000 NGN = 50000000 kobo
LIVENESS_THRESHOLD_KOBO=50000000
DVA_EXPIRY_DAYS=7
# Hours before unresolved dispute auto-escalates to human
DISPUTE_AUTO_ESCALATE_HOURS=48
MAX_NIN_ATTEMPTS=3
# Deal value cap for MVP (kobo) — 0 = no cap
DEAL_VALUE_CAP_KOBO=0
