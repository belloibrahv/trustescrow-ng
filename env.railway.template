# ═══════════════════════════════════════════════════════════
# TrustEscrow NG - Environment Variables Template
# Use this as a reference for production env vars.
# Never commit real secrets to version control.
# ═══════════════════════════════════════════════════════════

# SERVER
NODE_ENV=production
LOG_LEVEL=info

# SECURITY (Generate new secrets for production!)
ADMIN_JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
ADMIN_USERS={"admin":"REPLACE_ME","operator":"REPLACE_ME"}
ADMIN_DEFAULT_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD
ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARS
NIN_SALT=REPLACE_WITH_RANDOM_SALT

# DATABASE
DATABASE_URL=REPLACE_WITH_DATABASE_CONNECTION_STRING

# REDIS
REDIS_URL=REPLACE_WITH_REDIS_CONNECTION_STRING

# AFRICA'S TALKING
AT_USERNAME=REPLACE_WITH_USERNAME
AT_API_KEY=REPLACE_WITH_API_KEY
AT_SHORTCODE=REPLACE_WITH_SHORTCODE
AT_SENDER_ID=REPLACE_WITH_SENDER_ID

# PAYSTACK
PAYSTACK_SECRET_KEY=REPLACE_WITH_PAYSTACK_SECRET_KEY
PAYSTACK_PUBLIC_KEY=REPLACE_WITH_PAYSTACK_PUBLIC_KEY
PAYSTACK_WEBHOOK_SECRET=REPLACE_WITH_PAYSTACK_WEBHOOK_SECRET
PAYSTACK_DVA_PROVIDER=wema-bank

# PREMBLY IDENTITYPASS
PREMBLY_API_KEY=REPLACE_WITH_PREMBLY_API_KEY
PREMBLY_APP_ID=REPLACE_WITH_PREMBLY_APP_ID
PREMBLY_BASE_URL=https://sandbox.prembly.com

# AI PROVIDER CONFIGURATION
AI_PROVIDER=fallback
AI_MODEL=llama-3.3-70b-groq
GROQ_API_KEY=REPLACE_WITH_GROQ_API_KEY
GITHUB_TOKEN=REPLACE_WITH_GITHUB_TOKEN
DEEPSEEK_API_KEY=REPLACE_WITH_DEEPSEEK_API_KEY

# FEATURE FLAGS
USE_MOCK_NIN=false
USE_MOCK_PAYSTACK=false
LIVENESS_THRESHOLD_KOBO=50000000
DVA_EXPIRY_DAYS=7
DISPUTE_AUTO_ESCALATE_HOURS=48
MAX_NIN_ATTEMPTS=3
DEAL_VALUE_CAP_KOBO=0

# URLS
APP_URL=https://your-app-url.example.com
ADMIN_CORS_ORIGIN=https://your-admin-url.example.com
