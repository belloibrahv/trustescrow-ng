# Railway Dockerfile for TrustEscrow API (Monorepo)
FROM node:20-slim

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    python3 \
    make \
    g++ \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy package.json for API
COPY apps/api/package.json ./package.json

# Install dependencies
RUN npm install --legacy-peer-deps --no-audit

# Copy shared packages (required for TypeScript compilation)
COPY packages ./packages

# Copy API source files
COPY apps/api/tsconfig.json ./tsconfig.json
COPY apps/api/build.js ./build.js
COPY apps/api/src ./src
COPY apps/api/prisma ./prisma

# Build the application
RUN npm run build

# Remove dev dependencies after build
RUN npm prune --production --no-audit

# Create non-root user for security
RUN useradd -r -s /bin/false -u 1001 trustescrow && \
    chown -R trustescrow:trustescrow /app

USER trustescrow

# Expose port (Railway will set PORT env var)
EXPOSE 3000

# Start the application
CMD ["npm", "start"]